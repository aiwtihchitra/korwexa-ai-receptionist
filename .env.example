# OpenAI Realtime API (required)
# Get your key from https://platform.openai.com/api-keys
# Note: Emergent LLM key is NOT supported for the Realtime API - direct OpenAI key required.
OPENAI_API_KEY=sk-...

# Twilio credentials (required for signing/validation)
# Get from https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Server
PORT=8001

# Business identity — used dynamically in the receptionist greeting:
# "Hello! Thank you for calling {BUSINESS_NAME}. This is Sara. How may I assist you today?"
BUSINESS_NAME=Your Business Name

# OpenAI Realtime configuration
OPENAI_REALTIME_MODEL=gpt-realtime
# Female voice by default. Options: shimmer | alloy | echo | verse | coral | sage | cedar
OPENAI_REALTIME_VOICE=shimmer

# Logging: debug | info | warn | error
LOG_LEVEL=info

# Optional: public hostname (without protocol) used to build the TwiML wss:// URL.
# If empty, the server derives it from the incoming request Host header.
# Example: korwexa-voice.up.railway.app
PUBLIC_HOSTNAME=
